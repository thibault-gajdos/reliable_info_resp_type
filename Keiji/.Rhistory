rm(list=ls(all=TRUE))  ## efface les données
library(tidyverse)
library(cmdstanr)
library(simcausal)
library(posterior)
library(bayesplot)
exp <- 2; # specify which experiment to run
data <- read.csv(paste0("../data/DATA_EXPChoiceReliab_Exp", as.character(exp),".csv"))
data <- data %>%
separate(Sample_Reliability, into = paste0("proba_", 1:6), sep = "\\s+") %>%
mutate(across(starts_with("proba_"), as.numeric)) %>%
mutate(color = str_extract_all(Sample_Color, "blue|red"))  %>%
unnest_wider(color, names_sep = "_") %>%
rowwise() %>%
mutate(sample_number = sum(!is.na(c_across(starts_with("proba_")))))
data <- data %>%
mutate_at(vars(starts_with("color")), ~ ifelse(. == "blue", 1, 2))
# choose rows 60 times randomly
dat1 <- data %>%
group_by(ParticipantPrivateID) %>%
slice_sample(n=30)
dat2 <- dat1 %>% mutate(color_1 = recode(color_1, '1' = 2, '2' = 1)) %>%
mutate(color_2 = recode(color_2, '1' = 2, '2' = 1)) %>%
mutate(color_3 = recode(color_3, '1' = 2, '2' = 1)) %>%
mutate(color_4 = recode(color_4, '1' = 2, '2' = 1)) %>%
mutate(color_5 = recode(color_5, '1' = 2, '2' = 1)) %>%
mutate(color_6 = recode(color_6, '1' = 2, '2' = 1))
data_replacement <- bind_rows(data,dat1,dat2)
# create a sequence
dat1 <- data %>%
group_by(ParticipantPrivateID) %>%
slice(1) %>% slice(rep(1,30))
dat1 <- dat1 %>% mutate(proba_1 = 65) %>%
mutate(proba_2 = 65) %>%
mutate(proba_3 = 55) %>%
mutate(proba_4 = 55) %>%
mutate(proba_5 = 50) %>%
mutate(proba_6 = 55) %>%
mutate(color_1 = 2) %>%
mutate(color_2 = 2) %>%
mutate(color_3 = 2) %>%
mutate(color_4 = 1) %>%
mutate(color_5 = 1) %>%
mutate(color_6 = 1)
dat2 <- data %>%
group_by(ParticipantPrivateID) %>%
slice(1) %>% slice(rep(1,30))
dat2 <- dat2 %>% mutate(proba_1 = 65) %>%
mutate(proba_2 = 65) %>%
mutate(proba_3 = 55) %>%
mutate(proba_4 = 55) %>%
mutate(proba_5 = 50) %>%
mutate(proba_6 = 55) %>%
mutate(color_1 = 1) %>%
mutate(color_2 = 1) %>%
mutate(color_3 = 1) %>%
mutate(color_4 = 2) %>%
mutate(color_5 = 2) %>%
mutate(color_6 = 2)
data_sim <- bind_rows(data,dat1,dat2)
# define the data set again
data = data_replacement
# prepare the data list
N = length(unique(data$ParticipantPrivateID))
T_max = data%>% group_by(ParticipantPrivateID) %>% summarise(n=n())
T_max = T_max$n[1]
I =  sum(grepl("color", names(data))) ## number of samples/trial
## compute trials by subject
d <- data %>%
group_by(ParticipantPrivateID) %>%
summarise(t_subjs = n())
t_subjs <- d$t_subjs
subjs <- unique(data$ParticipantPrivateID)
Tsubj = t_subjs
## Initialize data arrays
color <- array( -1, c(N, T_max, I))
proba <- array(-1, c(N, T_max, I))
sample <- array(-1, c(N, T_max))
## fill the  arrays
for (n in 1:N) {
t <- t_subjs[n] ## number of trials for subj i
data_subj <- data %>% filter(ParticipantPrivateID == subjs[n])
for (j in 1:t) {
data_subj_t <- data_subj[j,]
sample[n,j] <- data_subj_t$sample_number
for (i in 1:I) {
color_var <- paste0("color_", i)
proba_var <- paste0("proba_", i)
color[n, j, i] <- data_subj[[color_var]][j]
proba[n, j, i] <- data_subj[[proba_var]][j]/100
}
}
}
## ####################################################
## ## SIMULATE RESPONSES
## ###################################################
simul_basic <- function(alpha, beta, lambda, theta, color_info, proba_info){
## initialisation
T = nrow(color_info)
I = ncol(color_info)
choice  = rep(-1,T)
evidence_1  =rep(-1,T)
evidence_2  =rep(-1,T)
x  =rep(-1,T)
## generate responses
for (t in c(1:T)){
evidence = c(0,0) ## initial value
for (i in c(1:I)){
l = log(proba_info[t,i] / (1 - proba_info[t,i]) ) ;
log_odds = alpha * l + beta;
if (color_info[t,i] == 1){## blue
evidence[1] = evidence[1] + exp(lambda * (i - I)) * log_odds;
}else{## red
evidence[2] = evidence[2] + exp(lambda * (i - I)) * log_odds;
}
}
x[t] <- plogis(theta*(evidence[2] - evidence[1]))
choice[t] <- rbern(1, x[t]) + 1 # 2 = red, 1 = blue
evidence_1[t] = evidence[1]
evidence_2[t] = evidence[2]
}
return(list(choice,evidence_1,evidence_2,x))
}
# parameter setting from the data observed
mu_alpha = 1.5;
mu_beta = 0.2;
mu_lambda = 0.07;
mu_theta = 2.7;
sigma_alpha = 0.8;
sigma_beta = 0.18;
sigma_lambda = 0.07;
sigma_theta = 0.8;
## ## SIMULATION
choice  <- array(-1, c(N, T_max))
params_indiv  <- array(-1, c(N, 4))
for (n in 1:N){
params_indiv[n,1] = rnorm(1,mu_alpha,sigma_alpha)
params_indiv[n,2] = rnorm(1,mu_beta,sigma_beta)
params_indiv[n,3] = rnorm(1,mu_lambda,sigma_lambda)
params_indiv[n,4] = rnorm(1,mu_theta,sigma_theta)
choice[n,] <-  simul_basic(alpha = params_indiv[n,1], beta = params_indiv[n,2], lambda = params_indiv[n,3], theta = params_indiv[n,4], color_info = color[n,,], proba_info = proba[n,,])[[1]]
# choice[n,] <-  simul_basic(alpha = params_indiv[n,1], beta = params_indiv[n,2], lambda = params_indiv[n,3], theta = params_indiv[n,4], color_info = color[n,,], proba_info = proba[n,,])[[4]]
}
###### fit the model ########
I_max = I
data_list <- list(
N = N,
T_max = T_max,
I_max = I_max,
Tsubj = t_subjs,
color = color,
proba = proba,
choice = choice, ##
sample = sample
)
data = data_sim
save(data_list, file = paste0('../results/fits/simulation/data_list_sim_observed', '.rdata'))
whichmodel <- 'choice_log_basic';
data_list$grainsize = 5 ## specify grainsize for within chain parallelization
## Compile the model
model <- cmdstan_model(
stan_file = paste0('../stan/', whichmodel, '.stan'),
force_recompile = TRUE, ## necessary if you change the mode
cpp_options = list(stan_opencl = FALSE, stan_threads = TRUE), ## within chain parallel
stanc_options = list("O1"), ## fastest sampling
compile_model_methods = TRUE ## necessary for loo moment matching
)
## Sampling
fit <- model$sample(
data = data_list,
seed = 4321,
chains = 4,
parallel_chains = 4,
threads_per_chain = 4,
iter_warmup = 2000,
iter_sampling = 1000,
max_treedepth = 12,
adapt_delta = .9,
save_warmup = FALSE
)
## Pairs plots
# Extract the current fit
posterior_samples <- fit$draws()
posterior_df <- as_draws_df(posterior_samples)
selected_params <- posterior_df[, grepl("^mu", colnames(posterior_df)) & !grepl("^mu_pr", colnames(posterior_df))]
plot <- mcmc_pairs(selected_params,
off_diag_args = list(size = 0.1, alpha=0.1))
plot
plot
plot_file <- paste0('../results/plots/simulation',exp, '/',target,'/trace_plot_', whichmodel,"_exp", exp)
plot_file <- paste0('../results/plots/simulation','/pairs_plot_', whichmodel,'_sim_ideal')
ggsave(plot, file = paste0(plot_file, ".jpeg"), width = 8, height = 8)
## Save results
save(fit, file = paste0('../results/fits/simulation', '/fit_',whichmodel, '_sim_observed', '.rdata'))
