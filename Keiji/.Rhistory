judgement == 2 ~ secondstim_actor,
judgement == 999 ~ 999),
preferred_label = case_when(judgement == 1 ~ firststim_label,
judgement == 2 ~ secondstim_label,
judgement == 999 ~ 999))
data_clean1 <- data_clean1 %>%
left_join(data.frame(ParticipantPrivateID = unique(data_raw$ParticipantPrivateID),
PID = seq_along(unique(data_raw$ParticipantPrivateID))),
by = "ParticipantPrivateID")
# write_csv(data_clean1, "data_clean1.csv")
# data_clean1 <- read_excel("~/OneDrive - University College London/Action & Body/Crying/Analysis/Silvia2/data_frame-1.xlsx") %>%
#   mutate(PID = participant_id,
#          ParticipantPrivateID = participant_id,
#          firststim_label = firstvideo_label,
#          firststim_actor = firstvideo_actor_id,
#          secondstim_label = secondvideo_label,
#          secondstim_actor = secondvideo_actor_id)
data_clean1 %>% group_by(PID) %>% count()
error_rates <- data_clean1 %>%
mutate(judgement_ERR = recode(judgement, "1" = 0, "2" = 0, "999" = 1)) %>%
group_by(ParticipantPrivateID, PID) %>%
summarise(prob_error = mean(judgement_ERR))
ggplot(error_rates, aes(x = prob_error)) +
geom_histogram()
error_rates %>% filter(prob_error > 0.25)
data_clean2 <- data_clean1 %>%
filter(!ParticipantPrivateID %in% c("10444307", "10444310", "10445067","10445204"))
data_clean2 %>% group_by(PID) %>% count()
data2 <- data_clean2 %>%
mutate(preferred_order = ifelse(preferred_actor == firststim_actor, 1, 2),
preferred_stimulus = preferred_actor * 10 + preferred_label,
first_stimulus = firststim_actor *10 + firststim_label,
second_stimulus = secondstim_actor *10 + secondstim_label,
comparison_between_act = case_when(firststim_actor == secondstim_actor ~ "same_actor",
firststim_actor != secondstim_actor ~ "different_actor"))
# Checking number of trials per combination (not explained very well in this label)
stim1_check <- data2 %>% group_by(PID, first_stimulus) %>% summarise(n1 = n())
stim1_check %>% filter(n1 != 22) # should be 0, as we expect all participants to have completed exactly 22 trials with each stimulus presented first
stim2_check <- data2 %>% group_by(PID, second_stimulus) %>% summarise(n2 = n())
stim2_check %>% filter(n2 != 22) # should be 0, as we expect all participants to have completed exactly 22 trials with each stimulus presented second
data2 <- data2 %>%
filter(judgement != "999")
# Quick check of design
ezDesign(data = data2, x = .(PID), y = .(preferred_actor), col = .(preferred_label)) # 3 missing data
# pref_prob for each non-crying video per participant
data3_L0_PP <- data2 %>%
filter(judgement != 999,
preferred_label != 999) %>%
group_by(PID, preferred_actor) %>%
summarise(
totaltrials = n(),
n = sum(preferred_label == 0),
.groups = "drop") %>%
complete(PID, preferred_actor, fill = list(totaltrials = 0, n = 0)) %>%
mutate(
pref_prob = ifelse(totaltrials > 0, n / totaltrials, 0),
condition = "L0")
# pref_prob for each crying video per participant
data3_L2_PP <- data2 %>%
filter(judgement != 999,
preferred_label != 999) %>%
group_by(PID, preferred_actor) %>%
summarise(
totaltrials = n(),
n = sum(preferred_label == 2),
.groups = "drop"
) %>%
complete(PID, preferred_actor, fill = list(totaltrials = 0, n = 0)) %>%  # ensures all combinations
mutate(
pref_prob = ifelse(totaltrials > 0, n / totaltrials, 0),
condition = "L2")
# pref_prob for each video (non-crying and crying) per participant
# pref_probs_PP <- bind_rows(data3_L0_PP, data3_L2_PP) %>%
#   select(PID, preferred_actor, condition, pref_prob) %>%
#   mutate(diff_L2_L0 = (condition == "L2") - (condition == "L0"),
#          preferred_actor = factor(preferred_actor))
pref_probs_PP <- bind_rows(data3_L0_PP, data3_L2_PP) %>%
select(PID, preferred_actor, pref_prob, condition) %>%
pivot_wider(names_from = condition,
values_from = pref_prob) %>%
mutate(diff_L2_L0 = L2 - L0,
preferred_actor = factor(preferred_actor)) %>%
pivot_longer(
L0:diff_L2_L0,
names_to = "condition",
values_to = "pref_prob")
# pref_prob for each non-crying video
data3_L0 <- data2 %>%
filter(judgement != 999,
preferred_label != 999) %>%
group_by(preferred_actor) %>%
summarise(
totaltrials = n(),
n = sum(preferred_label == 0),
.groups = "drop") %>%
complete(preferred_actor, fill = list(totaltrials = 0, n = 0)) %>%
mutate(
pref_prob = ifelse(totaltrials > 0, n / totaltrials, 0),
condition = "L0")
# pref_prob for each crying video
data3_L2 <- data2 %>%
filter(judgement != 999,
preferred_label != 999) %>%
group_by(preferred_actor) %>%
summarise(
totaltrials = n(),
n = sum(preferred_label == 2),
.groups = "drop"
) %>%
complete(preferred_actor, fill = list(totaltrials = 0, n = 0)) %>%  # ensures all combinations
mutate(
pref_prob = ifelse(totaltrials > 0, n / totaltrials, 0),
condition = "L2")
data3_sanity <- data2 %>%
filter(judgement != 999,
comparison_between_act == "same_actor",
preferred_label != 999) %>%
group_by(preferred_actor) %>%
summarise(
totaltrials = n(),
n = sum(preferred_label == 2),
.groups = "drop") %>%
complete(preferred_actor, fill = list(totaltrials = 0, n = 0)) %>%
mutate(
pref_prob = ifelse(totaltrials > 0, n / totaltrials, 0),
condition = "sanity")
# pref_prob for each video (non-crying and crying)
# pref_probs <- bind_rows(data3_sanity, data3_L0, data3_L2) %>%
#   select(preferred_actor, condition, pref_prob) %>%
#   mutate(diff_L2_L0 = (condition == "L2") - (condition == "L0"),
#          preferred_actor = factor(preferred_actor))
pref_probs <- bind_rows(data3_sanity, data3_L0, data3_L2) %>%
select(preferred_actor, pref_prob, condition) %>%
pivot_wider(names_from = condition,
values_from = pref_prob) %>%
mutate(diff_L2_L0 = L2 - L0,
preferred_actor = factor(preferred_actor)) %>%
pivot_longer(
sanity:diff_L2_L0,
names_to = "condition",
values_to = "pref_prob")
## =========================
## RUN FOR Bartlett Analysis
## =========================
f_scores_Bartlett <- read_excel("bartlettscores.xlsx") %>%
rename(
F1 = `F1-offset`,
F2 = `F2-focus`,
F3 = `F3-efficacy`,
F4 = `F4-sociocul`,
F5 = `F5-somatic`) %>%
pivot_longer(F1:F5, names_to = "factor", values_to = "score") %>%
mutate(preferred_actor = as.factor(StimulusID)) %>%
select(preferred_actor, factor, score)
f_scores_Bartlett_wide <- f_scores_Bartlett %>%
pivot_wider(names_from = factor, values_from = score)
f_scores_Bartlett_wide_PP <- inner_join(f_scores_Bartlett_wide, pref_probs_PP, by = "preferred_actor") %>%
pivot_wider(names_from = condition, values_from = pref_prob)
f_scores_Bartlett_PP <- inner_join(f_scores_Bartlett, pref_probs_PP, by = "preferred_actor") %>%
pivot_wider(names_from = condition, values_from = pref_prob)
f_scores_Bartlett_PP <- inner_join(f_scores_Bartlett, pref_probs_PP, by = "preferred_actor") %>%
pivot_wider(names_from = condition, values_from = pref_prob)
f_scores_Bartlett_joined <- inner_join(f_scores_Bartlett, pref_probs, by = "preferred_actor") %>%
pivot_wider(names_from = condition, values_from = pref_prob)
f_scores_Bartlett_joined <- inner_join(f_scores_Bartlett, pref_probs, by = "preferred_actor") %>%
pivot_wider(names_from = condition, values_from = pref_prob)
f_scores_Bartlett_long <- inner_join(f_scores_Bartlett, pref_probs, by = "preferred_actor") %>%
mutate(score_z = scale(score)[,1])
f_scores_Bartlett_joined <- inner_join(f_scores_Bartlett, pref_probs, by = "preferred_actor") %>%
pivot_wider(names_from = condition, values_from = pref_prob)
f_scores_Bartlett_long <- inner_join(f_scores_Bartlett, pref_probs, by = "preferred_actor") %>%
mutate(score_z = scale(score)[,1])
f_scores_Bartlett_long_PP <- inner_join(f_scores_Bartlett, pref_probs_PP, by = "preferred_actor") %>%
mutate(score_z = scale(score)[,1])
f_scores_Bartlett_long_PP <- inner_join(f_scores_Bartlett, pref_probs_PP, by = "preferred_actor") %>%
mutate(score_z = scale(score)[,1])
f_scores_long     <- f_scores_Bartlett_long
f_scores_Bartlett_long_PP <- inner_join(f_scores_Bartlett, pref_probs_PP, by = "preferred_actor") %>%
mutate(score_z = scale(score)[,1])
f_scores_long     <- f_scores_Bartlett_long
f_scores_long_PP  <- f_scores_Bartlett_long_PP
f_scores_long_PP  <- f_scores_Bartlett_long_PP
f_scores_wide_PP  <- f_scores_Bartlett_wide_PP
f_scores_Bartlett_joined <- inner_join(f_scores_Bartlett, pref_probs, by = "preferred_actor") %>%
pivot_wider(names_from = condition, values_from = pref_prob)
f_scores_Bartlett_long <- inner_join(f_scores_Bartlett, pref_probs, by = "preferred_actor") %>%
mutate(score_z = scale(score)[,1])
f_scores_Bartlett_long_PP <- inner_join(f_scores_Bartlett, pref_probs_PP, by = "preferred_actor") %>%
mutate(score_z = scale(score)[,1])
f_scores_long     <- f_scores_Bartlett_long
f_scores_long_PP  <- f_scores_Bartlett_long_PP
f_scores_wide_PP  <- f_scores_Bartlett_wide_PP
f_scores_PP       <- f_scores_Bartlett_PP
View(f_scores_long_PP)
View(f_scores_wide_PP)
library(brms)
complete_lmer <- lmer(scale(diff_L2_L0) ~ F1 + F2 + F3 + F4 + F5 + (1  + F1 || PID)
, data = f_scores_wide_PP)
tab_model(complete_lmer)
tab_model(complete_lmer)
summary(complete_lmer)
complete_brm <- brm(scale(diff_L2_L0) ~ F1 + F2 + F3 + F4 + F5 + (1 | PID)
, data = f_scores_wide_PP)
tab_model(complete_brm)
summary(complete_brm)
complete_brm <- brm(scale(diff_L2_L0) ~ F1 + F2 + F3 + F4 + F5 + (1 + F1 | PID)
, data = f_scores_wide_PP)
tab_model(complete_brm)
tab_model(complete_brm)
summary(complete_brm)
complete_brm <- brm(scale(diff_L2_L0) ~ F1 + F2 + F3 + F4 + F5 + (1 + F1 + F2 + F3 + F4 + F5 | PID)
, data = f_scores_wide_PP)
summary(complete_brm)
plot(complete_brm)
complete_brm <- brm(scale(diff_L2_L0) ~ F1 + F2 + F3 + F4 + F5 + (1 + F1 + F2 + F3 + F4 + F5 || PID)
, data = f_scores_wide_PP)
ranef(complete_brm)
fiexf(complete_brm)
fixef(complete_brm)
summary(complete_brm)
tab_model(complete_brm)
