color[n, j, i] <- data_subj[[color_var]][j]
proba[n, j, i] <- data_subj[[proba_var]][j]/100
}
}
}
## ####################################################
## ## SIMULATE RESPONSES
## ###################################################
simul_basic <- function(alpha, beta, lambda, theta, color_info, proba_info){
## initialisation
T = nrow(color_info)
I = ncol(color_info)
choice  = rep(-1,T)
evidence_1  =rep(-1,T)
evidence_2  =rep(-1,T)
x  =rep(-1,T)
## generate responses
for (t in c(1:T)){
evidence = c(0,0) ## initial value
for (i in c(1:I)){
l = log(proba_info[t,i] / (1 - proba_info[t,i]) ) ;
log_odds = alpha * l + beta;
if (color_info[t,i] == 1){## blue
evidence[1] = evidence[1] + exp(lambda * (i - I)) * log_odds;
}else{## red
evidence[2] = evidence[2] + exp(lambda * (i - I)) * log_odds;
}
}
x[t] <- plogis(theta*(evidence[2] - evidence[1]))
choice[t] <- rbern(1, x) + 1 # 2 = red, 1 = blue
evidence_1[t] = evidence[1]
evidence_2[t] = evidence[2]
}
return(list(choice,evidence_1,evidence_2,x))
}
mu_alpha = 1;
mu_beta = 0.01;
mu_lambda = 0;
mu_theta = 3;
sigma_alpha = 0.1;
sigma_beta = 0.001;
sigma_lambda = 0
sigma_theta = 0.05
## ## SIMULATION
choice  <- array(-1, c(N, T_max))
params_indiv  <- array(-1, c(N, 4))
for (n in 1:N){
params_indiv[n,1] = rnorm(1,mu_alpha,sigma_alpha)
params_indiv[n,2] = rnorm(1,mu_beta,sigma_beta)
params_indiv[n,3] = rnorm(1,mu_lambda,sigma_lambda)
params_indiv[n,4] = rnorm(1,mu_theta,sigma_theta)
choice[n,] <-  simul_basic(alpha = params_indiv[n,1], beta = params_indiv[n,2], lambda = params_indiv[n,3], theta = params_indiv[n,4], color_info = color[n,,], proba_info = proba[n,,])[[1]]
# choice[n,] <-  simul_basic(alpha = params_indiv[n,1], beta = params_indiv[n,2], lambda = params_indiv[n,3], theta = params_indiv[n,4], color_info = color[n,,], proba_info = proba[n,,])[[4]]
}
###### fit the model ########
I_max = I
data_list <- list(
N = N,
T_max = T_max,
I_max = I_max,
Tsubj = t_subjs,
color = color,
proba = proba,
choice = choice, ##
sample = sample
)
save(data_list, file = paste0('../results/fits/simulation/data_list', '.rdata'))
whichmodel <- 'choice_log_basic';
data_list$grainsize = 5 ## specify grainsize for within chain parallelization
## Compile the model
model <- cmdstan_model(
stan_file = paste0('../stan/', whichmodel, '.stan'),
force_recompile = TRUE, ## necessary if you change the mode
cpp_options = list(stan_opencl = FALSE, stan_threads = TRUE), ## within chain parallel
stanc_options = list("O1"), ## fastest sampling
compile_model_methods = TRUE ## necessary for loo moment matching
)
## Sampling
fit <- model$sample(
data = data_list,
seed = 4321,
chains = 4,
parallel_chains = 4,
threads_per_chain = 4,
iter_warmup = 2000,
iter_sampling = 1000,
max_treedepth = 12,
adapt_delta = .9,
save_warmup = FALSE
)
## Pairs plots
# Extract the current fit
posterior_samples <- fit$draws()
posterior_df <- as_draws_df(posterior_samples)
selected_params <- posterior_df[, grepl("^mu", colnames(posterior_df)) & !grepl("^mu_pr", colnames(posterior_df))]
plot <- mcmc_pairs(selected_params,
off_diag_args = list(size = 0.1, alpha=0.1))
plot
rm(list=ls(all=TRUE))  ## efface les données
params_indiv
rm(list=ls(all=TRUE))  ## efface les données
