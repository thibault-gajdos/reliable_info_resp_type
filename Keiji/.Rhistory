for (i in 1:I) {
color_var <- paste0("color_", i)
proba_var <- paste0("proba_", i)
color[n, j, i] <- data_subj[[color_var]][j]
proba[n, j, i] <- data_subj[[proba_var]][j]/100
}
}
}
